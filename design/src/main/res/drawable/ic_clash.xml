<?xml version="1.0" encoding="utf-8"?>
<!--
  Parciv mark for the main screen and the about screen: same silhouette as the
  launcher icon. The glyph takes the app accent (color_clash_dark) and the bar
  takes the launcher orange, which keeps it readable on both themes without a
  values-night variant, since this module picks its accents in code.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="128dp"
    android:height="128dp"
    android:viewportWidth="128"
    android:viewportHeight="128">
    <!-- glyph spans x 39..89, y 13..116, so it sits centred on the canvas -->
    <path
        android:fillColor="#1976d2"
        android:pathData="M39,13 h20 v86 h-20 z" />
    <path
        android:fillColor="#1976d2"
        android:pathData="M59,13 a30,30 0 1 1 0,60 v-15 a15,15 0 1 0 0,-30 z" />
    <path
        android:fillColor="#f39800"
        android:pathData="M44,106 h40 a5,5 0 1 1 0,10 h-40 a5,5 0 1 1 0,-10 z" />
</vector>
